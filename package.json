{
	"private": true,
	"name": "node-typescript-starter",
	"version": "1.0.0",
	"description": "A very opinionated template for Node.js applications written in TypeScript.",
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"tsc:build": "tsc --project ./tsconfig.json",
		"tsc:check": "tsc --project ./tsconfig.json --noEmit",
		"tsc:watch": "tsc --project ./tsconfig.json --noEmit --watch",
		"build": "pnpm run tsc:build",
		"start": "node ./dist/main.js",
		"dev": "nodemon",
		"check": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"prepack": "pnpm run build"
	},
	"files": [
		"dist/**/*"
	],
	"dependencies": {
		"tslib": "2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/git": "11.0.1",
		"@swc-node/register": "1.12.1",
		"@tsconfig/node-lts": "26.0.1",
		"@tsconfig/strictest": "2.0.5",
		"@types/node": "20.19.43",
		"@types/semantic-release": "21.1.0",
		"@vitest/coverage-v8": "3.2.7",
		"@vitest/ui": "3.2.7",
		"nodemon": "3.1.14",
		"semantic-release": "25.0.9",
		"typescript": "7.0.2",
		"vitest": "3.2.7"
	},
	"release": {
		"branches": [
			"main",
			"next",
			{
				"name": "alpha",
				"prerelease": true
			},
			{
				"name": "beta",
				"prerelease": true
			}
		],
		"preset": "angular",
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/changelog",
			"@semantic-release/github",
			"@semantic-release/git"
		]
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
