{
	"private": true,
	"name": "node-typescript-starter",
	"version": "1.0.0",
	"description": "A very opinionated template for Node.js applications written in TypeScript.",
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"tsc:build": "tsc --project ./tsconfig.json",
		"tsc:check": "tsc --project ./tsconfig.json --noEmit",
		"tsc:watch": "tsc --project ./tsconfig.json --noEmit --watch",
		"build": "pnpm run tsc:build",
		"start": "node ./dist/main.js",
		"dev": "nodemon",
		"check": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"prepack": "pnpm run build"
	},
	"files": [
		"dist/**/*"
	],
	"dependencies": {
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@semantic-release/changelog": "6.0.3",
		"@semantic-release/git": "10.0.1",
		"@swc-node/register": "1.10.9",
		"@tsconfig/node-lts": "22.0.4",
		"@tsconfig/strictest": "2.0.5",
		"@types/node": "20.19.43",
		"@types/semantic-release": "21.1.0",
		"@vitest/coverage-v8": "3.2.7",
		"@vitest/ui": "3.2.7",
		"nodemon": "3.1.9",
		"semantic-release": "24.2.1",
		"typescript": "5.7.3",
		"vitest": "3.2.7"
	},
	"release": {
		"branches": [
			"main",
			"next",
			{
				"name": "alpha",
				"prerelease": true
			},
			{
				"name": "beta",
				"prerelease": true
			}
		],
		"preset": "angular",
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			"@semantic-release/changelog",
			"@semantic-release/github",
			"@semantic-release/git"
		]
	},
	"engines": {
		"node": "v26.13.0"
	},
	"packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
